    "InventoryEngine.process_event(detection) -> InventoryEvent | None",
    "InventoryEngine.get_state() -> InventoryState",
    "InventoryEngine.get_analytics() -> dict",
    "InventoryEngine.get_restock() -> list[dict]",
    "InventoryEngine.reset()",
