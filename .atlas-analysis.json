  "keyFeatures": [
    "YOLOv8-seg computer vision model trained on 7 real store products",
    "Real-time product removal and return detection from RTSP or USB camera feed",
    "Automatic inventory decrement/increment with anti-false-positive cooldown and 3-frame consistency check",
    "Exponential smoothing depletion prediction (minutes until stockout per SKU)",
    "Slot-based activity heatmap aggregated over a configurable time window",
    "Intelligent narrative engine generating Spanish-language status messages",
    "FastAPI + Socket.IO backend broadcasting live updates to React dashboard",
    "Annotated live video overlay with bounding boxes and traffic-light stock indicators",
    "Priority-scored restock recommendations combining fill rate and sales velocity (iventa)",
    "Configurable alert threshold via hot-reload API endpoint"
  ],
  "publicApiSurface": [
    "GET /api/health",
    "GET /api/inventory",
    "GET /api/inventory/{sku_id}",
    "GET /api/events",
