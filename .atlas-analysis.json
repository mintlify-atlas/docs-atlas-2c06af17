    "PredictionEngine.predict(history) -> StockPrediction",
    "PredictionEngine.predict_all(histories) -> list[StockPrediction]",
    "HeatmapEngine.record(event)",
    "HeatmapEngine.get_heatmap(window_seconds) -> dict",
    "NarrativeEngine.generate(event_type, **kwargs) -> NarrativeMessage | None",
    "NarrativeEngine.get_recent(limit) -> list[NarrativeMessage]"
